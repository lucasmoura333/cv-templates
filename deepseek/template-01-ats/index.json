{
  "template_id": "deepseek/template-01-ats",
  "collection": "deepseek",
  "version": 1,
  "name": "ATS / Corporate",
  "description": "Uma coluna, hierarquia limpa e zero ruído visual — máxima compatibilidade com parsing ATS.",
  "tags": [
    "ats",
    "1-coluna",
    "corporativo"
  ],
  "page": {
    "size": "A4",
    "margin": "0"
  },
  "fonts": [
    "Inter"
  ],
  "accent": "#1a3a5c",
  "features": {
    "columns": 1,
    "ats_safe": true,
    "page_break_rules": true,
    "standalone": true
  },
  "files": {
    "html": "index.html",
    "css": "styles.css",
    "preview": null
  },
  "data_contract": {
    "attributes": {
      "field": "data-field",
      "repeat": "data-repeat",
      "editable": "data-editable"
    },
    "fields": [
      "cv.name",
      "cv.role",
      "cv.location",
      "cv.email",
      "cv.phone",
      "cv.github",
      "cv.linkedin",
      "cv.summary"
    ],
    "repeats": {
      "experience": [
        "role",
        "company",
        "period",
        "location",
        "bullets"
      ],
      "projects": [
        "name",
        "link",
        "description",
        "tech"
      ],
      "education": [
        "course",
        "institution",
        "period"
      ],
      "languages": [
        "language",
        "level"
      ],
      "skills": [
        "group",
        "items"
      ],
      "certifications": [
        "name"
      ]
    }
  },
  "data_contract_implemented": true,
  "notes": "Referência de implementação do contrato de dados (data-field/data-repeat)."
}
